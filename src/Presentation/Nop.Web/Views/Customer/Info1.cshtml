                <div class="inputs">
                    <label asp-for="ParentBankDetailsModel.BranchName"></label>
                    <input asp-for="ParentBankDetailsModel.BranchName" class="bank-input" autocomplete="off" />
                    <nop-required />
                </div>
                <div class="inputs">
                    <label asp-for="ParentBankDetailsModel.BranchAddress"></label>
                    <input asp-for="ParentBankDetailsModel.BranchAddress" class="bank-input" autocomplete="off" />
                    <nop-required />
                </div>
                <div class="inputs">
                    <label asp-for="ParentBankDetailsModel.AccountHolderName"></label>
                    <input asp-for="ParentBankDetailsModel.AccountHolderName" class="bank-input" autocomplete="off" />
                    <nop-required />
                </div>
                <div class="inputs">
                    <label asp-for="ParentBankDetailsModel.AccountNumber"></label>
                    <input asp-for="ParentBankDetailsModel.AccountNumber" class="bank-input" autocomplete="off" />
                    <nop-required />
