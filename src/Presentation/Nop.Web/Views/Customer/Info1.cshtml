<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputs = document.querySelectorAll(".bank-input");
        const editBtn = document.getElementById("editBank");
        const cancelBtn = document.getElementById("cancelEdit");
        const saveBtn = document.getElementById("saveBank");

        // --- Store original values for cancel ---
        const originalValues = {};
        inputs.forEach(input => {
            originalValues[input.name] = input.value;
        });

        // --- Disable all inputs if already filled ---
        const allHaveValues = Array.from(inputs).every(input => input.value.trim() !== "");
        if (allHaveValues) {
            inputs.forEach(input => input.disabled = true);
            if (saveBtn) saveBtn.disabled = true;
        }

        // --- Edit / Update button ---
        editBtn?.addEventListener("click", function (e) {
            e.preventDefault(); // Prevent normal form submit
            const isEditMode = editBtn.textContent.trim().toLowerCase() === "edit";
            const isEditMode1 = editBtn.textContent.trim() === "編集";

            if (isEditMode || isEditMode1) {
                // ✅ Step 1: Switch to Update mode
                inputs.forEach(input => input.disabled = false);
                editBtn.textContent = "@T("Admin.Commission.Update")";
                editBtn.classList.add("updating");
                cancelBtn?.classList.add("visible");
                if (saveBtn) saveBtn.disabled = true;
            } else {
                // ✅ Step 2: Call backend (Update)
                const postData = {
                    Id: $('input[name="ParentBankDetailsModel.Id"]').val(), // ✅ reads hidden input
                    BankName: $('input[name="ParentBankDetailsModel.BankName"]').val(),
                    BranchName: $('input[name="ParentBankDetailsModel.BranchName"]').val(),
                    BranchAddress: $('input[name="ParentBankDetailsModel.BranchAddress"]').val(),
                    AccountHolderName: $('input[name="ParentBankDetailsModel.AccountHolderName"]').val(),
                    AccountNumber: $('input[name="ParentBankDetailsModel.AccountNumber"]').val(),
                    AccountType: $('input[name="ParentBankDetailsModel.AccountType"]').val(),
                    SwiftOrBicCode: $('input[name="ParentBankDetailsModel.SwiftOrBicCode"]').val(),
                    CurrencyCode: $('input[name="ParentBankDetailsModel.CurrencyCode"]').val(),
                    ParentEmail: $('input[name="ParentBankDetailsModel.ParentEmail"]').val(),
                    CreatedDateTimeUtc: $('input[name="ParentBankDetailsModel.CreatedDateTimeUtc"]').val(), // ✅ reads hidden input
                    ModelUsername: "@Model.Username",
                    ModelEmail: "@Model.Email"
                };

                addAntiForgeryToken(postData);

                $.ajax({
                    cache: false,
                    type: "POST",
                    url: "@Url.Action("EditBankDetails", "Customer")",
                    data: postData,
                    dataType: "json",
                    success: function (data) {
                        if (data.error) {
                            if (data.error === 'Bank name is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error1")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank branch name is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error2")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank branch address is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error3")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank account holder name is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error4")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank account number is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error5")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank account type is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error6")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Bank Swift or Bic code is required.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error7")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }

                            if (data.error === 'Failed to update your bank details. Please contact the administrator for assistance.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Error8")')
                                    .addClass("field-validation-error")
                                    .removeClass("field-validation-valid")
                                    .css("color", "red");
                            }
                        } else {
                            if (data.message === 'Your bank details has been successfully updated.') {
                                $('#error1')
                                    .text('@T("Account.CommissionEditBank.Success")')
                                    .removeClass("field-validation-error")
                                    .addClass("field-validation-valid")
                                    .css("color", "green");

                                // ✅ Lock inputs after successful update
                                inputs.forEach(input => {
                                    input.disabled = true;
                                    originalValues[input.name] = input.value;
                                });

                                editBtn.textContent = "@T("Common.Edit")";
                                editBtn.classList.remove("updating");
                                cancelBtn?.classList.remove("visible");
                                if (saveBtn) saveBtn.disabled = true;
                            }
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        alert("Request failed: " + jqXHR.responseText);
                    }
                });
            }
        });

        // --- Cancel button ---
        cancelBtn?.addEventListener("click", function () {
            inputs.forEach(input => {
                input.value = originalValues[input.name] || "";
                input.disabled = true;
            });

            editBtn.textContent = "@T("Common.Edit")";
            editBtn.classList.remove("updating");
            cancelBtn.classList.remove("visible");
            if (saveBtn) saveBtn.disabled = true;
        });
    });
</script>
