<script asp-location="Footer">
    $(function () {        
        $('#save').on('click', function () {
            var email = $('input[name="Email"]').val();
            var modelUsername = "@Model.Username";
            var modelEmail = "@Model.Email";
            console.log(email);
            var postData = {
                email: email,
                modelUsername: modelUsername,
                modelEmail: modelEmail
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("SaveLevel2Child", "Customer")", // your controller route
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.error) {
                        //alert("Error: " + data.error);

                        if (data.error === 'Email is required.') {
                            $('#error')
                                .text('@T("Account.Commission.Error1")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'Invalid email format.') {
                            $('#error')
                                .text('@T("Account.Commission.Error2")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'You are not allowed to add yourself as a Line 2 downline.') {
                            $('#error')
                                .text('@T("Account.Commission.Error3")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'The user does not exist. Please ask the user to register first.') {
                            $('#error')
                                .text('@T("Account.Commission.Error4")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'This user has already been registered under another parent.') {
                            $('#error')
                                .text('@T("Account.Commission.Error5")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'You cannot add your parent as your child.') {
                            $('#error')
                                .text('@T("Account.Commission.Error6")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'A child is not allowed to add their parent as a downline.') {
                            $('#error')
                                .text('@T("Account.Commission.Error7")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }

                        if (data.error === 'Failed to add your new Line 2 downline. Please contact the administrator for assistance.') {
                            $('#error')
                                .text('@T("Account.Commission.Error8")')
                                .addClass("field-validation-error")
                                .removeClass("field-validation-valid")
                                .css("color", "red");
                        }
                    } else {
                        if (data.message === 'Your new Line 2 downline has been successfully added.') {
                            $('#error')
                                .text('@T("Account.Commission.Success")')
                                .removeClass("field-validation-error")
                                .addClass("field-validation-valid")
                                .css("color", "green");

                                //location.href = data.redirect;
                            }
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("Request failed: " + jqXHR.responseText);
                }
            });
        });
    });


