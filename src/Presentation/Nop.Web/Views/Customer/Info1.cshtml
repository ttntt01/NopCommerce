                    </div>
                </div>
            </div>
            </br>
            <div class="title">                
                <strong>@T("Account.Commission.YourDownlineReg")</strong>
            </div>
            <div class="form-fields">
                <div class="inputs">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="off" value="" />
