@model ProductModel

<div class="card-body">
    @await Html.PartialAsync("Table", new DataTablesModel
    {
        Name = "productfile-grid",
        UrlRead = new DataUrl("ProductFileList", "Product", new RouteValueDictionary { [nameof(Model.ProductFileSearchModel.ProductId)] = Model.ProductFileSearchModel.ProductId }),
        UrlDelete = new DataUrl("ProductFileDelete", "Product", null),        
        Length = Model.ProductFileSearchModel.PageSize,
        LengthMenu = Model.ProductFileSearchModel.AvailablePageSizes,
        ColumnCollection = new List<ColumnProperty>
            {
                new ColumnProperty(nameof(ProductFileModel.FileUrl))
                {
                    Title = T("Admin.Catalog.Products.Multimedia.Files.Fields.File").Text,
                    Render = new RenderCustom("renderFilesColumnProductFileUrl")
                },
                new ColumnProperty(nameof(ProductFileModel.Id))
                {
                    Title = T("Admin.Common.Delete").Text,
                    Width = "100",
                    Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                    ClassName = NopColumnClassDefaults.Button
                }
            }
    })

    <script>
        function renderFilesColumnProductFileUrl(data, type, row, meta) {
            return '<a href="' + row.PictureUrl + '" target="_blank"><img alt="' + row.PictureId + '" src="' + row.PictureUrl + '" width="150" /></a>';
        }
    </script>

    <div class="card card-default">
        <div class="card-header">
            @T("Admin.Catalog.Products.Multimedia.File.AddNew")
        </div>
        <div class="card-body">
            <div class="form-group row">
                @{
                    ViewData["Endpoint"] = this.Url.Action("ProductFileAdd", "Product", new { productId = Model.Id });
                    ViewData["TableSelector"] = "#productfile-grid";
                }
                <div class="col-md-3">
                    <nop-label asp-for="AddFileModel.FileId" />
                </div>
                <div class="col-md-9">
                    <nop-editor asp-for="AddFileModel.FileId" />
                    <span asp-validation-for="AddFileModel.FileId"></span>
                </div>
            </div>
        </div>
    </div>
</div>
