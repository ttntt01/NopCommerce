                                <div class="col-md-9">
                                    <input asp-for="Status" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="Status"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="BankName" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="BankName" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="BankName"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="BranchName" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="BranchName" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="BranchName"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="BranchAddress" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="BranchAddress" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="BranchAddress"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="AccountHolderName" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="AccountHolderName" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="AccountHolderName"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="AccountNumber" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="AccountNumber" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="AccountNumber"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="AccountType" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="AccountType" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="AccountType"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="SwiftOrBicCode" />
                                </div>
                                <div class="col-md-9">
                                    <input asp-for="SwiftOrBicCode" readonly style="width:100%; height:calc(2.25rem + 2px); padding:.375rem .75rem; background-color: #e9ecef; color: #6c757d; cursor: not-allowed; border: 1px solid transparent; box-shadow: none;" />
                                    <span asp-validation-for="SwiftOrBicCode"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="IsPaid" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="IsPaid" />
                                    <span asp-validation-for="IsPaid"></span>                                    
                                </div>
                                <div class="col-md-6">
                                    <button type="submit" name="commission-update" class="btn btn-primary" style="float: right; @(Model.IsPaid ? "background-color: #d6d6d6; border-color: #d6d6d6; color: #999; cursor: not-allowed;" : "")"
                                    @(Model.IsPaid ? "disabled" : "")>
                                        <i class="far fa-save"></i>
                                        @T("Admin.Commission.Update")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>        
</form>