@using Nop.Web.Areas.Admin.Models.Commission
@model Nop.Web.Areas.Admin.Models.Commission.CommissionSearchModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.Commission").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Commission");
}

@{
    const string hideSearchBlockAttributeName = "CommissionPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<form asp-controller="Product" asp-action="ProductTags" method="post" id="product-tags-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Commission")
        </h1>
        <div class="float-right">
            &nbsp;
            @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ProductTagListButtons, additionalData = Model })            
        </div>
    </div>

    <script>
        function renderDate(data, type, row) {
            if (!data) return '';

            const date = new Date(data);
            const pad = n => n.toString().padStart(2, '0');

            const year = date.getFullYear();
            const month = pad(date.getMonth() + 1);
            const day = pad(date.getDate());
            const hours = pad(date.getHours());
            const minutes = pad(date.getMinutes());
            const seconds = pad(date.getSeconds());

            return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
        }
    </script>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>

                            <div class="search-body @(hideSearchBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="Year" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="Year" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="Month" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="Month" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="ParentEmail" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="ParentEmail" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SelectedIsPaid" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="SelectedIsPaid" asp-items="Model.IsPaidList" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="text-center col-12">
                                        <button type="button" id="search-commission" class="btn btn-primary btn-search">
                                            <i class="fas fa-search"></i>
                                            @T("Admin.Common.Search")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cards-group">
                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "commission-grid",
                                UrlRead = new DataUrl("ParentChildSumOrderStatsList", "Commission", null),
                                SearchButtonId = "search-commission",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new FilterParameter(nameof(Model.Year)),
                                    new FilterParameter(nameof(Model.Month)),
                                    new FilterParameter(nameof(Model.ParentEmail)),
                                    new FilterParameter(nameof(Model.SelectedIsPaid))
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.Id))
                                    {
                                        IsMasterCheckBox = true,
                                        Render = new RenderCheckBox("checkbox_comission"),
                                        ClassName =  NopColumnClassDefaults.CenterAll,
                                        Width = "50"
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.ParentEmail))
                                    {
                                        Title = T("Admin.Commission.ParentEmail").Text,
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.Year))
                                    {
                                        Title = T("Admin.Commission.Year").Text
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.Month))
                                    {
                                        Title = T("Admin.Commission.Month").Text,                                    
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.CurrencyCode))
                                    {
                                        Title = T("Admin.Commission.CurrencyCode").Text,
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.CurrencyRate))
                                    {
                                        Title = T("Admin.Commission.CurrencyRate").Text
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.TotalOrderAmount))
                                    {
                                        Title = T("Admin.Commission.TotalOrderAmount").Text,
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.TotalOrderCount))
                                    {
                                        Title = T("Admin.Commission.TotalOrderCount").Text,
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.CreatedDateTimeUtc))
                                    {
                                        Title = T("Admin.Commission.CreatedDateTimeUtc").Text,
                                        Render = new RenderCustom("renderDate")
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.LastUpdatedTimeUtc))
                                    {
                                        Title = T("Admin.Commission.LastUpdatedTimeUtc").Text,
                                        Render = new RenderCustom("renderDate")
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.IsPaid))
                                    {
                                        Title = T("Admin.Commission.IsPaid").Text,
                                        Width = "80",
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Render = new RenderBoolean()
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.PayAmount))
                                    {
                                        Title = T("Admin.Commission.PayAmount").Text,
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.ExecuteStartDateTime))
                                    {
                                        Title = T("Admin.Commission.ExecuteStartDateTime").Text,
                                        Render = new RenderCustom("renderDate")
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.ExecuteEndDateTime))
                                    {
                                        Title = T("Admin.Commission.ExecuteEndDateTime").Text,
                                        Render = new RenderCustom("renderDate")
                                    },
                                    new ColumnProperty(nameof(ParentChildSumOrderStatsModel.Id))
                                    {
                                        Title = T("Admin.Common.Edit").Text,
                                        Width = "80",
                                        ClassName =  NopColumnClassDefaults.Button,
                                        //Render = new RenderButtonEdit(new DataUrl("Edit", "Commission", new RouteValueDictionary { { "area", "Admin" }, { "id", "__id__" } }))
                                        Render = new RenderButtonEdit(new DataUrl("/Admin/Commission/Edit/"))
                                    }    
                                }
                            })                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
